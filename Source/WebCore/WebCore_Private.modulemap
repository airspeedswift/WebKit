framework module WebCore_Private [system] {
    module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    // The CSS unit vocabulary, shared by the tokenizer and calc boundary modules and owned by
    // neither. A header may appear in only one submodule, so CSSUnitType.h lives here rather
    // than in CSSTokenizerSwiftTypes below, where reaching it would drag CSSParserTokenBits.h
    // and the rest of the tokenizer boundary into the calc boundary.
    //
    // CSSUnitConversions.h holds the conversion constants split out of CSSUnits.h, so that
    // Swift unit canonicalization reads the same constants C++ does rather than transcribing
    // them.
    explicit module CSSUnitsSwiftTypes {
        header "CSSUnitType.h"
        header "CSSUnitConversions.h"
        requires cplusplus
        export *
    }

    // The Swift boundary module for the CSS tokenizer, so that a Swift file imports only the
    // types it needs rather than the Core umbrella below, and so that one boundary cannot
    // reach another's types. See CSSTokenizerSwiftTypes.h.
    explicit module CSSTokenizerSwiftTypes {
        header "CSSTokenizerSwiftTypes.h"
        header "CSSParserTokenBits.h"
        requires cplusplus
        export *
    }

    // The boundary module for calc() serialization. Separate from the module above because the
    // two boundaries are unrelated, and a module stating both would let code importing either
    // reach the other's types.
    explicit module CSSCalcSwiftTypes {
        header "CSSCalcSwiftTypes.h"
        requires cplusplus
        export *
    }

    // `CSSCalc::Type`, the css-typed-om numeric type, and its algebra: `Type::multiply`,
    // `Type::invert`, `Type::calculationCategory` and `Type::determinePercentHint`, called from
    // Swift rather than reimplemented.
    //
    // CSSCalcType.h is self-contained enough to be its own boundary submodule: it includes only
    // `<array>`, `<optional>` and `<wtf/Forward.h>`, and forward-declares `CSSUnitType` and
    // `CSS::Category` rather than including their headers.
    //
    // `Type` must be spelled with backticks on the Swift side -- ``WebCore.CSSCalc.`Type` `` --
    // because the bare name parses as the metatype of the namespace enum, and the diagnostic
    // ("type 'WebCore.CSSCalc' has no member 'length'") does not name the cause.
    explicit module CSSCalcTypeSwiftTypes {
        header "CSSCalcType.h"
        requires cplusplus
        export *
    }

    // `CSS::Category`, the numeric category that `Type::determinePercentHint` takes and
    // `Type::calculationCategory` returns. A submodule of its own rather than a member of the
    // one above, because CSSPrimitiveNumericCategory.h is WebCore's general vocabulary, included
    // by hundreds of C++ headers, where CSSCalcType.h is specific to this boundary. It carries
    // `#include <wtf/Forward.h>` and nothing else.
    explicit module CSSPrimitiveNumericCategorySwiftTypes {
        header "CSSPrimitiveNumericCategory.h"
        requires cplusplus
        export *
    }

    module Core {
        // Stated here, ahead of the umbrella, so that this module's AST sees the complete
        // definition of `enum CSSValueID : uint16_t` first. An incomplete `enum X : uint16_t;`
        // declaration parsed before the complete definition, anywhere in the same Clang module,
        // makes the importer bring the type in with an empty enumerator list: Swift can then
        // name `WebCore.CSSValueID` but no enumerator of it. Twenty-two WebCore headers
        // forward-declare `CSSValueID` that way rather than include this 112 KB generated
        // header, and an `umbrella` directory is walked in filename order, so several of them
        // are parsed before "CSSValueKeywords.h" is reached.
        //
        // Naming the header here costs nothing else: it is already a member of this module via
        // the umbrella, which is why it must also be excluded below, so no translation unit
        // gains an include and the module's contents are unchanged. A dedicated non-umbrella
        // submodule does not work in its place, since the forward declaration only has to be
        // parsed first, not to be in the same submodule.
        header "CSSValueKeywords.h"

        // Workaround for rdar://173516139: PrivateHeaders includes a header
        // "WorkAround173516139.h" that the build system regenerates whenever
        // the header list changes.
        umbrella "PrivateHeaders"

        requires cplusplus

        // These headers are also present in WebKitLegacy's PrivateHeaders. When
        // <Foundation/NSGeometry.h> is unavailable (i.e. when building against a
        // public SDK), WAKAppKitStubs.h declares its own NSPoint/NSRect/NSSize,
        // so each module would get its own definitions of the WAK classes and
        // fail the cross-module ODR check. Let WebKitLegacy own them.
        exclude header "WAKAppKitStubs.h"
        exclude header "WAKClipView.h"
        exclude header "WAKResponder.h"
        exclude header "WAKScrollView.h"
        exclude header "WAKView.h"
        exclude header "WAKWindow.h"

        // Defines a category on NSView, which WAKAppKitStubs.h maps to WAKView
        // on iOS, so it needs the definition of the class excluded above.
        exclude header "WebCoreView.h"

        // These headers are already included via their dedicated modules above.
        exclude header "CSSTokenizerSwiftTypes.h"
        exclude header "CSSParserTokenBits.h"
        exclude header "CSSUnitType.h"
        exclude header "CSSUnitConversions.h"
        exclude header "CSSCalcSwiftTypes.h"
        exclude header "CSSCalcType.h"
        exclude header "CSSPrimitiveNumericCategory.h"

        // Stated as a header of Core above, ahead of the umbrella, so that it is parsed first.
        // See the comment there: without it no `CSSValueID` enumerator imports into Swift.
        exclude header "CSSValueKeywords.h"

        module * {
            export *
        }
    }
}
