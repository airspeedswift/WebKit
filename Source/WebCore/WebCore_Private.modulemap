framework module WebCore_Private [system] {
    module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    // The CSS unit vocabulary, shared by the tokenizer island and the two calc islands and owned by
    // neither -- so it is a third boundary submodule rather than a member of either of theirs.
    //
    // CSSUnitType.h MOVED HERE out of CSSTokenizerSwiftTypes below, and it had to: a header may
    // appear in exactly one submodule of a module map, so the calc simplification island could not
    // be given the unit constants beside the enum any other way. The alternative -- letting the calc
    // island import CSSTokenizerSwiftTypes -- would hand it CSSParserTokenBits.h and the tokenizer's
    // whole boundary, which is the opposite of what these submodules are for.
    //
    // CSSUnitConversions.h is the eleven `constexpr double` conversion constants, split out of
    // CSSUnits.h in the same shape and for the same reason CSSUnitType.h was: `canonicalize`'s
    // fourteen arithmetic cases are in Swift now and they multiply by these, so the island reads the
    // same constants the C++ reads rather than transcribing them. See CSSUnitConversions.h.
    explicit module CSSUnitsSwiftTypes {
        header "CSSUnitType.h"
        header "CSSUnitConversions.h"
        requires cplusplus
        export *
    }

    // The Swift island's boundary, its own module so that the island can import
    // *only* what it is allowed to see rather than the Core umbrella below. Walking
    // that umbrella reaches JavaScriptCore's private headers, where two inner structs
    // are defined in explicit submodules that nothing imports, and WTF::KeyValuePair's
    // instantiation over them then fails to compile — so importing the umbrella from
    // Swift does not build at all. See CSSTokenizerSwiftTypes.h.
    explicit module CSSTokenizerSwiftTypes {
        header "CSSTokenizerSwiftTypes.h"
        header "CSSParserTokenBits.h"
        requires cplusplus
        export *
    }

    // The calc serialization island's boundary, its own module for the same reason. Separate from
    // the module above rather than folded into it, because the two islands' boundaries are
    // unrelated and a module that stated both would let either island reach the other's types --
    // the point of these modules is to say what each may see.
    explicit module CSSCalcSwiftTypes {
        header "CSSCalcSwiftTypes.h"
        requires cplusplus
        export *
    }

    // `CSSCalc::Type` -- the css-typed-om numeric type, seven `int8_t` exponents and a percent hint
    // -- AND ITS WHOLE ALGEBRA, for the simplification island's step 9.4.
    //
    // THE ANSWER TO "IS CSSCalcType.h SELF-CONTAINED ENOUGH TO BE A BOUNDARY SUBMODULE" IS YES, and
    // it was compiled rather than reasoned about (`cssprobe/calcsimplify/typemodule/probe-type.swift`,
    // exit 0). It includes only `<array>`, `<optional>` and `<wtf/Forward.h>`, and it FORWARD-DECLARES
    // both `CSSUnitType` and `CSS::Category` rather than including their headers -- which is exactly
    // the property that lets it stand alone here while the two enums arrive through their own
    // submodules.
    //
    // WHAT THIS BUYS, AND WHY IT IS NOT A TRANSCRIPTION. `simplify(Product&)`'s step 9.4 needs
    // `Type::multiply`, `Type::invert`, `Type::calculationCategory` and
    // `Type::determinePercentHint`. The island CALLS those four; it does not reimplement them. That
    // is ~90 lines of integer arithmetic and an eleven-case category switch that exist exactly once
    // in the program, in CSSCalcType.cpp, and both arms reach the same definitions -- the same
    // standard `CSSUnitConversions.h` and `wtf.Core.MathExtras` are held to next door. The
    // alternative shapes were both worse: two or three new upcalls on `CSSCalcSwiftBuilder` (~30
    // lines of C++ written to facilitate Swift), or a Swift reimplementation (a second
    // implementation of a spec algorithm, agreeing on every common input and free to diverge on
    // exponent overflow and on the percent-hint merge).
    //
    // `Type` MUST BE SPELLED WITH BACKTICKS ON THE SWIFT SIDE -- ``WebCore.CSSCalc.`Type` `` -- because
    // bare `WebCore.CSSCalc.Type` parses as the METATYPE of the namespace enum and the diagnostic
    // ("type 'WebCore.CSSCalc' has no member 'length'") does not name the cause. Recorded here
    // because it is a property of this header's naming, not of the island.
    explicit module CSSCalcTypeSwiftTypes {
        header "CSSCalcType.h"
        requires cplusplus
        export *
    }

    // `CSS::Category`, the eleven-case numeric category, which `Type::determinePercentHint` takes and
    // `Type::calculationCategory` returns. A submodule of its own rather than a member of the one
    // above, for the same reason the two island boundaries are separate modules: this header is
    // WebCore's own vocabulary and is included by hundreds of C++ headers, where CSSCalcType.h is
    // one island's boundary.
    //
    // It carries `#include <wtf/Forward.h>` and nothing else. Compiled, not reasoned about
    // (`cssprobe/calcsimplify/typemodule/probe-type.swift`).
    //
    // IT REPLACES A PRECOMPUTED BYTE ON THE BOUNDARY. `CSSCalcSwiftSimplificationOptions` already
    // carries `category` as a raw `uint8_t`, and step 9.4's `Category::Percentage` arm needs
    // `Type::determinePercentHint(options.category)` -- which is *not* derivable from the
    // `percentageResolveToDimension` bool beside it, because that bool cannot tell `LengthPercentage`
    // from `AnglePercentage`. The plan of record (CSSCalcSimplificationSwift.swift's `foldHypot` note)
    // was to add a `percentHintForCategory` byte to the options struct. This makes that unnecessary:
    // the island reconstructs the real enum from the byte it already receives and calls the real
    // function, so no new production C++ was written for it.
    explicit module CSSPrimitiveNumericCategorySwiftTypes {
        header "CSSPrimitiveNumericCategory.h"
        requires cplusplus
        export *
    }

    module Core {
        // Workaround for rdar://173516139: PrivateHeaders includes a header
        // "WorkAround173516139.h" that the build system regenerates whenever
        // the header list changes.
        umbrella "PrivateHeaders"

        requires cplusplus

        // These headers are also present in WebKitLegacy's PrivateHeaders. When
        // <Foundation/NSGeometry.h> is unavailable (i.e. when building against a
        // public SDK), WAKAppKitStubs.h declares its own NSPoint/NSRect/NSSize,
        // so each module would get its own definitions of the WAK classes and
        // fail the cross-module ODR check. Let WebKitLegacy own them.
        exclude header "WAKAppKitStubs.h"
        exclude header "WAKClipView.h"
        exclude header "WAKResponder.h"
        exclude header "WAKScrollView.h"
        exclude header "WAKView.h"
        exclude header "WAKWindow.h"

        // Defines a category on NSView, which WAKAppKitStubs.h maps to WAKView
        // on iOS, so it needs the definition of the class excluded above.
        exclude header "WebCoreView.h"

        // These headers are already included via their dedicated modules above.
        exclude header "CSSTokenizerSwiftTypes.h"
        exclude header "CSSParserTokenBits.h"
        exclude header "CSSUnitType.h"
        exclude header "CSSUnitConversions.h"
        exclude header "CSSCalcSwiftTypes.h"
        exclude header "CSSCalcType.h"
        exclude header "CSSPrimitiveNumericCategory.h"

        module * {
            export *
        }
    }
}
