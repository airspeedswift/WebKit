framework module WebCore_Private [system] {
    module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    // The Swift island's boundary, its own module so that the island can import
    // *only* what it is allowed to see rather than the Core umbrella below. Walking
    // that umbrella reaches JavaScriptCore's private headers, where two inner structs
    // are defined in explicit submodules that nothing imports, and WTF::KeyValuePair's
    // instantiation over them then fails to compile — so importing the umbrella from
    // Swift does not build at all. See CSSTokenizerSwiftTypes.h.
    explicit module CSSTokenizerSwiftTypes {
        header "CSSTokenizerSwiftTypes.h"
        header "CSSParserTokenBits.h"
        requires cplusplus
        export *
    }

    // The calc serialization island's boundary, its own module for the same reason. Separate from
    // the module above rather than folded into it, because the two islands' boundaries are
    // unrelated and a module that stated both would let either island reach the other's types --
    // the point of these modules is to say what each may see.
    explicit module CSSCalcSwiftTypes {
        header "CSSCalcSwiftTypes.h"
        requires cplusplus
        export *
    }

    // The content-extensions island's boundary, its own module for the same reason again. It
    // names only the sink that carries the per-NFA handler; everything else the island touches --
    // Term, NFA, ImmutableNFANodeBuilder, CombinedFiltersAlphabet -- is reached through the
    // ordinary includes in that header, which resolve to the source tree through WebCore's own
    // target header map rather than to the Core umbrella.
    explicit module CombinedURLFiltersSwiftTypes {
        header "CombinedURLFiltersSwiftTypes.h"
        requires cplusplus
        export *
    }

    module Core {
        // Workaround for rdar://173516139: PrivateHeaders includes a header
        // "WorkAround173516139.h" that the build system regenerates whenever
        // the header list changes.
        umbrella "PrivateHeaders"

        requires cplusplus

        // These headers are also present in WebKitLegacy's PrivateHeaders. When
        // <Foundation/NSGeometry.h> is unavailable (i.e. when building against a
        // public SDK), WAKAppKitStubs.h declares its own NSPoint/NSRect/NSSize,
        // so each module would get its own definitions of the WAK classes and
        // fail the cross-module ODR check. Let WebKitLegacy own them.
        exclude header "WAKAppKitStubs.h"
        exclude header "WAKClipView.h"
        exclude header "WAKResponder.h"
        exclude header "WAKScrollView.h"
        exclude header "WAKView.h"
        exclude header "WAKWindow.h"

        // Defines a category on NSView, which WAKAppKitStubs.h maps to WAKView
        // on iOS, so it needs the definition of the class excluded above.
        exclude header "WebCoreView.h"

        // These headers are already included via their dedicated modules above.
        exclude header "CSSTokenizerSwiftTypes.h"
        exclude header "CSSParserTokenBits.h"
        exclude header "CSSCalcSwiftTypes.h"
        exclude header "CombinedURLFiltersSwiftTypes.h"

        module * {
            export *
        }
    }
}
