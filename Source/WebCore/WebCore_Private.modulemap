framework module WebCore_Private [system] {
    module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    // The CSS unit vocabulary, shared by the tokenizer and calc boundary modules and owned
    // by neither, so it is a third boundary submodule rather than a member of either.
    //
    // A header may appear in exactly one submodule of a module map, so CSSUnitType.h lives
    // here rather than in CSSTokenizerSwiftTypes below: putting it there would force the
    // calc simplification boundary to import CSSTokenizerSwiftTypes to reach it, pulling in
    // CSSParserTokenBits.h and the tokenizer's whole boundary along with it.
    //
    // CSSUnitConversions.h is the eleven `constexpr double` conversion constants, split out
    // of CSSUnits.h for the same reason CSSUnitType.h was: calc's unit canonicalization in
    // Swift multiplies by these and reads the same constants C++ does rather than
    // transcribing them. See CSSUnitConversions.h.
    explicit module CSSUnitsSwiftTypes {
        header "CSSUnitType.h"
        header "CSSUnitConversions.h"
        requires cplusplus
        export *
    }

    // The Swift boundary module for the CSS tokenizer, so a Swift file imports only
    // what it needs rather than the Core umbrella below. Walking that umbrella reaches
    // JavaScriptCore's private headers, where two inner structs are defined in explicit
    // submodules that nothing imports, and WTF::KeyValuePair's instantiation over them
    // then fails to compile, so importing the umbrella from Swift does not build at all.
    // See CSSTokenizerSwiftTypes.h.
    explicit module CSSTokenizerSwiftTypes {
        header "CSSTokenizerSwiftTypes.h"
        header "CSSParserTokenBits.h"
        requires cplusplus
        export *
    }

    // The boundary module for calc() serialization. Kept separate from the module above
    // because the two boundaries are unrelated, and a module stating both would let code
    // importing either reach the other's types.
    explicit module CSSCalcSwiftTypes {
        header "CSSCalcSwiftTypes.h"
        requires cplusplus
        export *
    }

    module Core {
        // Workaround for rdar://173516139: PrivateHeaders includes a header
        // "WorkAround173516139.h" that the build system regenerates whenever
        // the header list changes.
        umbrella "PrivateHeaders"

        requires cplusplus

        // These headers are also present in WebKitLegacy's PrivateHeaders. When
        // <Foundation/NSGeometry.h> is unavailable (i.e. when building against a
        // public SDK), WAKAppKitStubs.h declares its own NSPoint/NSRect/NSSize,
        // so each module would get its own definitions of the WAK classes and
        // fail the cross-module ODR check. Let WebKitLegacy own them.
        exclude header "WAKAppKitStubs.h"
        exclude header "WAKClipView.h"
        exclude header "WAKResponder.h"
        exclude header "WAKScrollView.h"
        exclude header "WAKView.h"
        exclude header "WAKWindow.h"

        // Defines a category on NSView, which WAKAppKitStubs.h maps to WAKView
        // on iOS, so it needs the definition of the class excluded above.
        exclude header "WebCoreView.h"

        // These headers are already included via their dedicated modules above.
        exclude header "CSSTokenizerSwiftTypes.h"
        exclude header "CSSParserTokenBits.h"
        exclude header "CSSUnitType.h"
        exclude header "CSSUnitConversions.h"
        exclude header "CSSCalcSwiftTypes.h"

        module * {
            export *
        }
    }
}
