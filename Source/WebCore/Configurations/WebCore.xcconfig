#include "FeatureDefines.xcconfig"
#include "../../../Configurations/Version.xcconfig"

GCC_PREFIX_HEADER = WebCorePrefix.h;

ENABLE_LLVM_PROFILE_GENERATION_DEFINES = $(ENABLE_LLVM_PROFILE_GENERATION_DEFINES_$(ENABLE_LLVM_PROFILE_GENERATION));
ENABLE_LLVM_PROFILE_GENERATION_DEFINES_YES = ENABLE_LLVM_PROFILE_GENERATION=1;

// IR PGO profile generation flags
WK_PGO_GEN_FLAGS = $(WK_PGO_GEN_FLAGS_$(ENABLE_LLVM_PROFILE_GENERATION));
WK_PGO_GEN_FLAGS_YES = -fprofile-generate;

GCC_PREPROCESSOR_DEFINITIONS = $(DEBUG_DEFINES) BUILDING_WEBKIT GL_SILENCE_DEPRECATION=1 GLES_SILENCE_DEPRECATION=1 $(ENABLE_PDFJS) $(ENABLE_LLVM_PROFILE_GENERATION_DEFINES) $(inherited) $(GCC_PREPROCESSOR_DEFINITIONS_$(ENABLE_WEBGPU_SWIFT)) $(WK_USE_SWIFT_CSS_TOKENIZER_DEFINES) $(WK_USE_SWIFT_CSS_COLOR_FAST_PATHS_DEFINES) $(WK_USE_SWIFT_CSS_CALC_SERIALIZATION_DEFINES);
GCC_PREPROCESSOR_DEFINITIONS_ENABLE_WEBGPU_SWIFT = ENABLE_WEBGPU_SWIFT;

// Selects the Swift CSS tokenizer island (CSSTokenizerSwift.swift) as the scanner the
// CSSTokenizer constructors use. Off by default: both scanners are compiled in either
// way, and which one ships is a separate decision from whether the island is correct.
//
// This exists so the choice has one reproducible home. The macro was previously defaulted
// in CSSTokenizer.h and set by no build file at all, which meant every measurement and
// every layout-test pass that did not hand-edit the header was running the C++ scanner --
// and because every in-tree test names the scanner explicitly, the whole suite passed
// identically with the island switched off for the entire product. Build with
// WK_USE_SWIFT_CSS_TOKENIZER=YES to select it, and confirm it took effect with
// webCoreCSSTokenizerDefaultScannerIsSwift() rather than assuming: an ignored flag must
// not be able to masquerade as a passing run.
WK_USE_SWIFT_CSS_TOKENIZER_DEFINES = $(WK_USE_SWIFT_CSS_TOKENIZER_DEFINES_$(WK_USE_SWIFT_CSS_TOKENIZER));
WK_USE_SWIFT_CSS_TOKENIZER_DEFINES_YES = USE_SWIFT_CSS_TOKENIZER=1;

// Selects the Swift colour fast-path island (CSSParserFastPathsSwift.swift) as the scanner
// CSSParserFastPaths uses for hex and named colours. Off by default, both scanners compiled in
// either way -- the same arrangement, and for the same reasons, as the tokenizer flag above.
//
// A *separate* flag rather than a reuse of that one deliberately. The two islands sit on
// unrelated entry points: `parseSimpleColor` short-circuits before a `CSSTokenizer` is ever
// constructed (CSSPropertyParser.cpp:286 versus :289), so nothing the tokenizer gate does can
// reach this code, and an A/B that could only move both at once would charge each island's
// result to the other. Confirm it took effect with the bridge's
// webCoreCSSColorFastPathsAreSwift() rather than assuming.
WK_USE_SWIFT_CSS_COLOR_FAST_PATHS_DEFINES = $(WK_USE_SWIFT_CSS_COLOR_FAST_PATHS_DEFINES_$(WK_USE_SWIFT_CSS_COLOR_FAST_PATHS));
WK_USE_SWIFT_CSS_COLOR_FAST_PATHS_DEFINES_YES = USE_SWIFT_CSS_COLOR_FAST_PATHS=1;

// Selects the Swift calc() serialization island (CSSCalcSerializationSwift.swift) as the serializer
// CSSCalc::serializationForCSS uses. Off by default, both serializers compiled in either way -- the
// same arrangement, and for the same reasons, as the two flags above.
//
// A third separate flag rather than a reuse of either, on the same grounds the colour flag gives:
// the three islands sit on unrelated entry points, and calc serialization is reached from
// `cssText` and getComputedStyle rather than from stylesheet parsing at all, so an A/B that could
// only move two islands at once would charge each one's result to the other. Confirm it took
// effect with the bridge's webCoreCSSCalcSerializationIsSwift() rather than assuming.
WK_USE_SWIFT_CSS_CALC_SERIALIZATION_DEFINES = $(WK_USE_SWIFT_CSS_CALC_SERIALIZATION_DEFINES_$(WK_USE_SWIFT_CSS_CALC_SERIALIZATION));
WK_USE_SWIFT_CSS_CALC_SERIALIZATION_DEFINES_YES = USE_SWIFT_CSS_CALC_SERIALIZATION=1;

WK_OPTIMIZATION_PROFILE_FILE = $(BUILT_PRODUCTS_DIR)/DerivedSources/WebCore/Profiling/$(arch).profdata;
WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER = $(WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER_$(USE_INTERNAL_SDK));
WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER_YES = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/Profiling;

WK_ENABLE_PGO_USE = $(WK_ENABLE_PGO_USE_$(WK_NOT_$(ENABLE_LLVM_PROFILE_GENERATION))_$(USE_INTERNAL_SDK)_$(CONFIGURATION)_$(WK_PLATFORM_NAME));
WK_ENABLE_PGO_USE_YES_YES_Release_macosx = YES;
WK_ENABLE_PGO_USE_YES_YES_Release_iphoneos = YES;
WK_ENABLE_PGO_USE_YES_YES_Release_xros = YES;
WK_ENABLE_PGO_USE_YES_YES_Production_macosx = YES;
WK_ENABLE_PGO_USE_YES_YES_Production_iphoneos = YES;
WK_ENABLE_PGO_USE_YES_YES_Production_xros = YES;

WK_PGO_USE_CFLAGS = $(WK_PGO_USE_CFLAGS_$(WK_ENABLE_PGO_USE));
WK_PGO_USE_CFLAGS_YES = -fprofile-use=$(WK_OPTIMIZATION_PROFILE_FILE) -Wno-error=backend-plugin;
WK_PGO_USE_LDFLAGS = $(WK_PGO_USE_LDFLAGS_$(WK_ENABLE_PGO_USE));
WK_PGO_USE_LDFLAGS_YES = -fprofile-use=$(WK_OPTIMIZATION_PROFILE_FILE) -Wno-error=backend-plugin;

// Switches on the Swift CSS tokenizer island's validation and benchmark bridge. Off by
// default so it does not ship; see wtf/PlatformEnable.h. Appended to OTHER_CFLAGS rather than
// added to GCC_PREPROCESSOR_DEFINITIONS because an xcodebuild command-line override of that
// setting would replace the whole list rather than extend it.
WK_CSS_TOKENIZER_SWIFT_BRIDGE_CFLAGS = $(WK_CSS_TOKENIZER_SWIFT_BRIDGE_CFLAGS_$(WK_ENABLE_CSS_TOKENIZER_SWIFT_BRIDGE));
WK_CSS_TOKENIZER_SWIFT_BRIDGE_CFLAGS_YES = -DENABLE_CSS_TOKENIZER_SWIFT_BRIDGE=1;

// The same switch on the Swift side, so the island's validation entry points
// (CSSUnitTrieSwift.swift) are compiled only when the bridge is. Without it the `@_expose(Cxx)`
// functions would be emitted into every WebCore.framework, which is the thing this flag exists
// to prevent -- an entry point that ships is interop cost whichever language it is written in.
// SWIFT_ACTIVE_COMPILATION_CONDITIONS rather than OTHER_SWIFT_FLAGS because builds routinely
// override the latter on the xcodebuild command line.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(WK_CSS_TOKENIZER_SWIFT_BRIDGE_CONDITIONS_$(WK_ENABLE_CSS_TOKENIZER_SWIFT_BRIDGE));
WK_CSS_TOKENIZER_SWIFT_BRIDGE_CONDITIONS_YES = ENABLE_CSS_TOKENIZER_SWIFT_BRIDGE;

OTHER_CFLAGS = $(inherited) $(WK_PGO_USE_CFLAGS) $(WK_PGO_GEN_FLAGS) $(WK_CSS_TOKENIZER_SWIFT_BRIDGE_CFLAGS);

// Remove below workaround once fix from rdar://146134116 is universally available in all supported configurations.
LLVM_PROFILE_GENERATION_OTHER_LD_FLAGS = $(LLVM_PROFILE_GENERATION_OTHER_LD_FLAGS_$(ENABLE_LLVM_PROFILE_GENERATION))
LLVM_PROFILE_GENERATION_OTHER_LD_FLAGS_YES = -Wl,-dirty_data_list,/dev/null;

FRAMEWORK_SEARCH_PATHS[sdk=embedded*] = $(WK_QUOTED_OVERRIDE_FRAMEWORKS_DIR) $(BUILT_PRODUCTS_DIR);
FRAMEWORK_SEARCH_PATHS[sdk=macosx*] = $(WK_QUOTED_OVERRIDE_FRAMEWORKS_DIR);

SYSTEM_FRAMEWORK_SEARCH_PATHS = $(inherited) $(WK_PRIVATE_SDK_DIR)$(SYSTEM_LIBRARY_DIR)/PrivateFrameworks $(SDK_DIR)$(SYSTEM_LIBRARY_DIR)/Frameworks;

HEADER_SEARCH_PATHS = /usr/include/libxslt /usr/include/libxml2 $(BUILT_PRODUCTS_DIR)/DerivedSources/WebCore $(BUILT_PRODUCTS_DIR)$(WK_LIBRARY_HEADERS_FOLDER_PATH) $(WEBKITADDITIONS_HEADER_SEARCH_PATHS) $(ANGLE_HEADER_SEARCH_PATHS) $(LIBWEBRTC_HEADER_SEARCH_PATHS) $(LIBWEBM_HEADER_SEARCH_PATHS) $(HEADER_SEARCH_PATHS) $(SRCROOT);
SYSTEM_HEADER_SEARCH_PATHS = $(PROJECT_DIR)/PAL/ThirdParty/dav1d/include $(WK_PRIVATE_SDK_DIR)$(WK_ALTERNATE_WEBKIT_SDK_PATH)$(WK_LIBRARY_HEADERS_FOLDER_PATH) $(inherited);
LIBRARY_SEARCH_PATHS = $(WK_PRIVATE_SDK_DIR)/System/Library/PrivateFrameworks/FontServices.framework "$(SDK_DIR)$(WEBCORE_LIBRARY_DIR)" $(SDK_DIR)$(WK_LIBRARY_INSTALL_PATH) "$(SDKROOT)/usr/lib/swift" $(inherited);

