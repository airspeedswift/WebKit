WK_NETWORK_EXTENSION_LDFLAGS_xros = -framework NetworkExtension;
WK_NETWORK_EXTENSION_LDFLAGS_xrsimulator = -framework NetworkExtension;
WK_NETWORK_EXTENSION_LDFLAGS_maccatalyst = -framework NetworkExtension;
