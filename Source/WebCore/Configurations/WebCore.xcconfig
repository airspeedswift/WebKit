OUTPUT_CRYPTEX_SYMLINK_PATH[sdk=macosx*] = $(OUTPUT_CRYPTEX_SYMLINK_PATH_$(USE_SYSTEM_CONTENT_PATH)_$(WK_USE_ALTERNATE_FRAMEWORKS_DIR));
OUTPUT_CRYPTEX_SYMLINK_PATH_YES_YES[sdk=macosx*] = $(DSTROOT)$(CRYPTEX_SYMLINK_PATH)/$(FULL_PRODUCT_NAME);


