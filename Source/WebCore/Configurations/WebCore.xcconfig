WEBCORE_ALLOWABLE_CLIENTS_YES = -allowable_client WebCoreTestSupport -allowable_client WebKitLegacy -allowable_client WebKit -allowable_client TestIPC -allowable_client TestWebKitAPI -allowable_client DumpRenderTree -allowable_client WebKitTestRunner $(WEBCORE_ALLOWABLE_CLIENTS_PLATFORM_$(WK_COCOA_TOUCH));
WEBCORE_ALLOWABLE_CLIENTS_PLATFORM_cocoatouch = -allowable_client iTunesU -allowable_client Casablanca -allowable_client Remote -allowable_client TVBooks;

OTHER_LDFLAGS = $(inherited) $(OTHER_LDFLAGS_SHARED_CACHE) $(JSC_SEC_LD_FLAGS) -weak-lxslt -lsqlite3 -lobjc $(WEBCORE_ALLOWABLE_CLIENTS) -force_load $(BUILT_PRODUCTS_DIR)/libPAL.a -lswiftCore -framework CFNetwork -framework CoreAudio -framework CoreGraphics -framework CoreText -framework Foundation -framework IOSurface -framework ImageIO -framework Metal -framework Network -lFontParser $(OTHER_LDFLAGS_PLATFORM_$(WK_PLATFORM_NAME)) $(WK_ANGLE_LDFLAGS) $(WK_WEBGPU_LDFLAGS) $(WK_APPKIT_LDFLAGS) $(WK_APPSUPPORT_LDFLAGS) $(WK_AUDIO_UNIT_LDFLAGS) $(WK_CARBON_LDFLAGS) $(WK_CORE_UI_LDFLAGS) $(WK_DATA_DETECTORS_CORE_LDFLAGS) $(WK_GRAPHICS_SERVICES_LDFLAGS) $(WK_IOSURFACE_ACCELERATOR_LDFLAGS) $(WK_LIBWEBRTC_LDFLAGS) $(WK_MOBILE_CORE_SERVICES_LDFLAGS) $(WK_MOBILE_GESTALT_LDFLAGS) $(WK_NETWORK_EXTENSION_LDFLAGS) $(WK_SYSTEM_CONFIGURATION_LDFLAGS) $(WK_CORE_IMAGE_LDFLAGS) $(WK_URL_FORMATTING_LDFLAGS) $(WK_UNIFORM_TYPE_IDENTIFIERS_LDFLAGS) $(SOURCE_VERSION_LDFLAGS) $(WK_PGO_USE_LDFLAGS) $(WK_PGO_GEN_FLAGS) $(WK_NO_STATIC_INITIALIZERS) $(WK_DEBUG_LDFLAGS) $(LLVM_PROFILE_GENERATION_OTHER_LD_FLAGS);

OTHER_LDFLAGS_PLATFORM_macosx = -sub_library libobjc $(WK_PGO_USE_LDFLAGS) $(WK_PGO_GEN_FLAGS);

// Use order files from WebKitAdditions for internal SDK macOS production builds
WK_ORDER_FILE = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/OrderFiles/WebCore.order.txt;
WK_ENABLE_ORDER_FILE = $(WK_ENABLE_ORDER_FILE_$(USE_INTERNAL_SDK)_$(CONFIGURATION)_$(WK_PLATFORM_NAME));
WK_ENABLE_ORDER_FILE_YES_Production_macosx = YES;
WK_ORDER_FILE_LDFLAGS = $(WK_ORDER_FILE_LDFLAGS_$(WK_ENABLE_ORDER_FILE));
WK_ORDER_FILE_LDFLAGS_YES = -Wl,-order_file,$(WK_ORDER_FILE);
SECTORDER_FLAGS = $(WK_ORDER_FILE_LDFLAGS);

EXCLUDED_SOURCE_FILE_NAMES = pdfjs*/*;
EXCLUDED_SOURCE_FILE_NAMES[sdk=iphone*] = $(inherited) *.tiff *Cursor.png npapi.h npfunctions.h npruntime.h npruntime_internal.h;
EXCLUDED_SOURCE_FILE_NAMES[sdk=xr*] = $(inherited) *.tiff *Cursor.png npapi.h npfunctions.h npruntime.h npruntime_internal.h modelDefaultDiffuseData modelDefaultSpecularData;

INCLUDED_SOURCE_FILE_NAMES = $(INCLUDED_SOURCE_FILE_NAMES_$(ENABLE_PDFJS));
INCLUDED_SOURCE_FILE_NAMES_ENABLE_PDFJS = pdfjs*/*;

ALLOW_SHARED_CACHE = $(ALLOW_SHARED_CACHE_$(WK_RELOCATABLE_FRAMEWORKS)_$(USE_STAGING_INSTALL_PATH)_$(WK_PLATFORM_NAME));
ALLOW_SHARED_CACHE_YES_YES_macosx = NO;
ALLOW_SHARED_CACHE_YES__macosx = NO;
ALLOW_SHARED_CACHE__YES_macosx = NO;

OTHER_LDFLAGS_SHARED_CACHE = $(OTHER_LDFLAGS_SHARED_CACHE_$(ALLOW_SHARED_CACHE));
OTHER_LDFLAGS_SHARED_CACHE_NO = -Wl,-not_for_dyld_shared_cache;

OTHER_CPLUSPLUSFLAGS = $(inherited) -fmodules -fno-cxx-modules;

// Enable InstallAPI support, when built with WEBCORE_ENABLE_INSTALLAPI=YES.
SUPPORTS_TEXT_BASED_API = $(SUPPORTS_TEXT_BASED_API_$(WK_ENABLE_SLOW_BUILD_VERIFICATION)_$(TARGET_NAME));
SUPPORTS_TEXT_BASED_API_YES_WebCore = $(WEBCORE_ENABLE_INSTALLAPI);
TAPI_USE_SRCROOT = YES;
TEXT_BASED_API_FILE = WebCore.tbd

// audit-spi normally only runs when SUPPORTS_TEXT_BASED_API is enabled.
// WebCore does not build with InstallAPI by default, and unlike other frameworks
// in our stack, its API surface is fully discoverable through binary analysis.
WK_AUDIT_SPI[sdk=iphoneos*] = $(WK_AND_$(WK_DEFAULT_WK_AUDIT_SPI)_$(WK_NOT_$(WK_ANY_SANITIZER_ENABLED)));
WK_AUDIT_SPI_ALLOWLISTS = $(SRCROOT)/Configurations/AllowedSPI.toml $(SRCROOT)/Configurations/AllowedSPI-legacy.toml $(WK_AUDIT_SPI_ALLOWLISTS_$(USE_INTERNAL_SDK));
WK_AUDIT_SPI_ALLOWLISTS_YES = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/AllowedSPI/AllowedSPI-WebCore.toml;

WK_HAVE_URL_FORMATTING = $(WK_HAVE_URL_FORMATTING_$(WK_PLATFORM_NAME));
WK_HAVE_URL_FORMATTING_iphoneos = YES;
WK_HAVE_URL_FORMATTING_iphonesimulator = YES;
WK_HAVE_URL_FORMATTING_watchos = YES;
WK_HAVE_URL_FORMATTING_watchsimulator = YES;
WK_HAVE_URL_FORMATTING_appletvos = NO
WK_HAVE_URL_FORMATTING_appletvsimulator = NO;
WK_HAVE_URL_FORMATTING_xros = YES;
WK_HAVE_URL_FORMATTING_xrsimulator = YES;
WK_HAVE_URL_FORMATTING_maccatalyst = YES;
WK_HAVE_URL_FORMATTING_macosx = YES;

// Whole-module, matching JavaScriptCore.xcconfig:80. Without it Xcode compiles Swift
// `-incremental -enable-batch-mode`, and nothing specializes across a Swift *file*
// boundary: a call from one file to a generic function in another reaches the
// unspecialized generic through a lazily-built conformance witness table, whatever
// specializations already sit in the same binary. In the CSS tokenizer island that cost
// 10.7 points, because `consumeNumericToken` called the unit trie's 17,898-instruction
// unspecialized form rather than the 943-instruction UInt8 one next to it. JSC has had
// this since its own island landed; WebCore inherited the common Swift settings and this
// was not among them, so every CSS island measurement before this was taken without it.
SWIFT_COMPILATION_MODE = wholemodule;

SWIFT_INSTALL_OBJC_HEADER = NO;
BUILD_LIBRARY_FOR_DISTRIBUTION = YES;
SWIFT_LIBRARY_LEVEL = spi;
_SWIFT_EXPLICIT_MODULES_ALLOW_CXX_INTEROP = YES;
SWIFT_OBJC_INTEROP_MODE = objcxx;

// Swift-in-WebCore (see webkit-swift-adoption-notes.md §8f). WebCore inherited
// the common Swift settings but was never wired to compile Swift: it had no
// module name, no generated-header name, and none of the @_expose(Cxx) flags.
SWIFT_OBJC_INTERFACE_HEADER_NAME = WebCoreSwift-Generated.h;

MODULEMAP_FILE = $(SRCROOT)/WebCore.modulemap;
MODULEMAP_PRIVATE_FILE = $(SRCROOT)/WebCore_Private.modulemap;

WK_VERIFY_WEBCORE_MODULE = $(WK_ENABLE_MODULE_VERIFIER);
WK_ENABLE_MODULE_VERIFIER = YES;
// Module requires bug fixes that shipped in 26.4.
WK_ENABLE_MODULE_VERIFIER[sdk=*26.2*] = ;
WK_ENABLE_MODULE_VERIFIER[sdk=*26.3*] = ;
// Disabled on internal builds of macOS due to rdar://175057536.
WK_ENABLE_MODULE_VERIFIER[sdk=macosx*.internal] = ;

ENABLE_MODULE_VERIFIER = $(ENABLE_MODULE_VERIFIER_$(WK_ENABLE_SLOW_BUILD_VERIFICATION));
ENABLE_MODULE_VERIFIER_YES = $(WK_VERIFY_WEBCORE_MODULE);
MODULE_VERIFIER_SUPPORTED_LANGUAGES = objective-c++;
MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = c++23;
MODULE_VERIFIER_KIND = builtin;

// SafeInteropWrappers synthesizes safe overloads for imported C++ functions whose
// pointer parameters carry __counted_by(n) plus noescape: const becomes Span, mutable
// becomes inout MutableSpan. It is what lets a Swift island hand a buffer to C++ with
// no `unsafe` at all (see swift-cpp-interop-notes.md §67). Enabled for WebCore only,
// rather than in CommonBase.xcconfig, because it is still an experimental feature and
// WebCore is the target that needs it.
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -std=c++2b -Xfrontend -clang-header-expose-decls=has-expose-attr-or-stdlib -Xfrontend -emit-clang-header-min-access -Xfrontend internal -enable-experimental-feature SafeInteropWrappers;

SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
DEFINES_MODULE = YES;

OTHER_MODULE_VERIFIER_FLAGS = -- $(WK_AVAILABILITY_OVERLAY_FLAGS) -iframework $(BUILT_PRODUCTS_DIR)/SDKAdditions/System/Library/Frameworks -I$(BUILT_PRODUCTS_DIR)$(WK_LIBRARY_HEADERS_FOLDER_PATH) -I$(BUILT_PRODUCTS_DIR)$(WK_LIBRARY_HEADERS_FOLDER_PATH)/webrtc -I$(WK_PRIVATE_SDK_DIR)$(WK_ALTERNATE_WEBKIT_SDK_PATH)$(WK_LIBRARY_HEADERS_FOLDER_PATH)/webrtc  -I$(WK_ADDITIONAL_SDKS)$(WK_LIBRARY_HEADERS_FOLDER_PATH) $(OTHER_MODULE_VERIFIER_FLAGS_$(WK_EMPTY_$(WK_OVERRIDE_FRAMEWORKS_DIR)));
OTHER_MODULE_VERIFIER_FLAGS_ = -iframework "$(WK_PRIVATE_SDK_DIR)$(WK_OVERRIDE_FRAMEWORKS_DIR)" -isystem "$(WK_PRIVATE_SDK_DIR)$(WK_ALTERNATE_WEBKIT_SDK_PATH)$(WK_LIBRARY_HEADERS_FOLDER_PATH)";

HEADERMAP_INCLUDES_FRAMEWORK_ENTRIES_FOR_TARGETS_NOT_BEING_BUILT = NO;
HEADERMAP_USES_VFS = YES;
