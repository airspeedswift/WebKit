#include "BaseTarget.xcconfig"

WK_OPTIMIZATION_PROFILE_FILE = $(BUILT_PRODUCTS_DIR)/DerivedSources/JavaScriptCore/Profiling/$(arch).profdata;
WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER = $(WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER_$(USE_INTERNAL_SDK));
WK_COMPRESSED_OPTIMIZATION_PROFILE_FOLDER_YES = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/Profiling;

// WTF builds first as a dependency of JSC and decompresses the same
// PGO profile JSC uses. JSC's Copy Profiling Data phase symlinks to WTF's
// already-decompressed output when present, falling back to a fresh decompression
// if WTF's output is missing. This saves 50MB of disk space at desk.
WK_CLANG_PGO_REUSE_FROM_TARGET = WTF;

WK_ENABLE_CLANG_PGO_USE = $(WK_ENABLE_CLANG_PGO_USE_$(WK_NOT_$(ENABLE_LLVM_PROFILE_GENERATION))_$(USE_INTERNAL_SDK)_$(CONFIGURATION)_$(WK_PLATFORM_NAME));
WK_ENABLE_CLANG_PGO_USE_YES_YES_Release_macosx = YES;
WK_ENABLE_CLANG_PGO_USE_YES_YES_Release_iphoneos = YES;
WK_ENABLE_CLANG_PGO_USE_YES_YES_Release_xros = YES;
WK_ENABLE_CLANG_PGO_USE_YES_YES_Production_macosx = YES;
WK_ENABLE_CLANG_PGO_USE_YES_YES_Production_iphoneos = YES;
WK_ENABLE_CLANG_PGO_USE_YES_YES_Production_xros = YES;

WK_CLANG_PGO_USE_CFLAGS = $(WK_CLANG_PGO_USE_CFLAGS_$(WK_ENABLE_CLANG_PGO_USE));
WK_CLANG_PGO_USE_CFLAGS_YES = -fprofile-use=$(WK_OPTIMIZATION_PROFILE_FILE) -Wno-error=backend-plugin;
WK_CLANG_PGO_USE_LDFLAGS = $(WK_CLANG_PGO_USE_LDFLAGS_$(WK_ENABLE_CLANG_PGO_USE));
WK_CLANG_PGO_USE_LDFLAGS_YES = -fprofile-use=$(WK_OPTIMIZATION_PROFILE_FILE) -Wno-error=backend-plugin;

// Swift's IR-PGO consumer only accepts profiles produced by clang's own IR PGO
// instrumentation, so only ever enable it in lockstep with WK_ENABLE_CLANG_PGO_USE
// rather than tracking it separately. Swift PGO is supported only starting from
// macOS 26, because earlier deployment targets generate a Frontend profile
// instead of an IR one.
WK_SWIFT_IR_PGO_SUPPORTED = YES;
WK_SWIFT_IR_PGO_SUPPORTED[sdk=macosx*] = $(WK_SWIFT_IR_PGO_SUPPORTED$(WK_MACOS_1500_2600));
WK_SWIFT_IR_PGO_SUPPORTED_MACOS_BEFORE_2600 = NO;
WK_SWIFT_IR_PGO_SUPPORTED_MACOS_SINCE_2600 = YES;

WK_SWIFT_PGO_USE_FLAGS = $(WK_SWIFT_PGO_USE_FLAGS_$(WK_AND_$(WK_ENABLE_CLANG_PGO_USE)_$(WK_SWIFT_IR_PGO_SUPPORTED)));
WK_SWIFT_PGO_USE_FLAGS_YES = -Xfrontend -ir-profile-use=$(WK_OPTIMIZATION_PROFILE_FILE);

OTHER_CFLAGS = $(inherited) $(WK_CLANG_PGO_USE_CFLAGS) $(WK_CLANG_PGO_GEN_FLAGS);
OTHER_LDFLAGS = $(inherited) $(WK_CLANG_PGO_USE_LDFLAGS) $(WK_CLANG_PGO_GEN_FLAGS);
// rdar://174426778: Force a 64-bit fat header, as some build configurations
// generate a >4GB static archive but do not trigger sizing logic inside lipo.
OTHER_LIPOFLAGS = $(inherited) -fat64;

SKIP_INSTALL = YES;

ENABLE_USER_SCRIPT_SANDBOXING = NO;

STRIP_INSTALLED_PRODUCT = NO;

EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(WK_SWIFT_BIGINT_DIGITS_EXCLUDED_$(WK_JSC_SUPPORTS_SWIFT_FOR_CXX));
EXCLUDED_SOURCE_FILE_NAMES[sdk=iphone*] = $(inherited) framework.sb $(WK_SWIFT_BIGINT_DIGITS_EXCLUDED_$(WK_JSC_SUPPORTS_SWIFT_FOR_CXX));
WK_SWIFT_BIGINT_DIGITS_EXCLUDED_ = JSBigIntDigits.swift JSBigIntDigitsAddSub.swift JSBigIntDigitsDivide.swift JSBigIntDigitsFFT.swift JSBigIntDigitsMultiply.swift JSBigIntDigitsPrimitives.swift;

// Swift compiled into libJavaScriptCore, whose C++ calls it through the generated header JSCSwift-Swift.h. It is
// a module of its own, apart from the framework's JavaScriptCore module, and it reaches C++ through
// JSCSwiftBoundary.modulemap, which names headers in the source tree, because libJavaScriptCore builds before the
// framework's headers are copied. The other settings are the framework's Swift settings in JavaScriptCore.xcconfig.
SWIFT_MODULE_NAME = JSCSwift;
SWIFT_INSTALL_OBJC_HEADER = NO;
SWIFT_COMPILATION_MODE = wholemodule;
SWIFT_ENABLE_COMPILE_CACHE = NO;
_SWIFT_EXPLICIT_MODULES_ALLOW_CXX_INTEROP = YES;
SWIFT_OBJC_INTEROP_MODE = objcxx;
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -fmodule-map-file=$(SRCROOT)/JSCSwiftBoundary.modulemap -Xcc -std=c++2b -Xcc -fno-exceptions -Xcc -fignore-exceptions -Xcc -O2 -Xllvm -enable-dfa-jump-thread -Xfrontend -clang-header-expose-decls=has-expose-attr-or-stdlib -Xfrontend -emit-clang-header-min-access -Xfrontend internal -enable-experimental-feature SafeInteropWrappers $(WK_SWIFT_PGO_USE_FLAGS) $(WK_SWIFT_PGO_GEN_FLAGS);

// BaseTarget.xcconfig's WK_USE_SWIFT_BIGINT_DIGITS, for JSBigInt's digit arithmetic in Swift.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(WK_SWIFT_BIGINT_DIGITS_CONDITIONS_$(WK_JSC_SUPPORTS_SWIFT_FOR_CXX)_$(WK_USE_SWIFT_BIGINT_DIGITS));
WK_SWIFT_BIGINT_DIGITS_CONDITIONS_YES_YES = USE_SWIFT_BIGINT_DIGITS;
WK_SWIFT_BIGINT_DIGITS_CONDITIONS_YES_YES[arch=armv7*] = ;
WK_SWIFT_BIGINT_DIGITS_CONDITIONS_YES_YES[arch=i386] = ;
